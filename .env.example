# BESONC environment variables
# Copy to .env and edit. All values shown are safe DEV defaults.

# ── Core infra ────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgresql://besonc:besonc_dev_pw@localhost:5432/besonc_dev

# Redis
REDIS_URL=redis://localhost:6379

# ── Service-to-service auth (Sprint 1-2 already had this) ────────────
JWT_SECRET=change-me-in-prod-this-is-only-for-dev-32-chars-min
JWT_EXPIRES_IN=7d

# ── External integrations ─────────────────────────────────────────────
# Leave blank to use the MOCK adapters (sandbox behaviour). When you
# put real values in, the REAL adapters kick in automatically — no code
# changes required on your PC.

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Hubtel SMS (https://unity.hubtel.com/account/api-credentials)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=BESONC

# Google Maps Routes API (https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=

# Smile ID (https://portal.smileidentity.com/api)
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_SID_SERVER=0

# Sentry (https://sentry.io/settings/projects/)
SENTRY_DSN=

# PostHog (https://posthog.com/project/settings)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Per-service ports (override only if you have port conflicts) ──────
PORT_API_GATEWAY=3000
PORT_AUTH=3001
PORT_USER=3002
PORT_CATALOGUE=3003
PORT_ORDER=3004
PORT_DISPATCH=3005
PORT_TRACKING=3006
PORT_PAYMENT=3007
PORT_NOTIFICATION=3008
PORT_MEDIA=3010
PORT_PRICING=3012
PORT_CHAT=3013
PORT_SEARCH=3014
PORT_RATING=3015
PORT_TIP=3016
PORT_PROMO=3017
PORT_COD=3018
PORT_BFF_CUSTOMER=4000
PORT_BFF_VENDOR=4001
PORT_BFF_RIDER=4002
PORT_BFF_ADMIN=4003
PORT_WEB_CUSTOMER=4200
PORT_WEB_VENDOR=4201
PORT_WEB_RIDER=4202
PORT_WEB_ADMIN=4203

# ── SMTP (Mailhog in dev) ─────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=besonc@localhost

# ── Settlement ─────────────────────────────────────────────────────────
# T+1 payout buffer (per v3.1 plan). For prod, set to 0 and rely on
# Paystack's own T+1 schedule. For dev, use a small buffer so we can
# trigger settlement manually.
SETTLEMENT_BUFFER_MINUTES=0
