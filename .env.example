# BESONC Environment Variables — copy this to .env and fill in your keys
# DO NOT commit .env to git (it's already in .gitignore)

# ============================================================================
# CORE SERVICES
# ============================================================================

# Paystack (https://paystack.com — sign up at https://paystack.com)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxx

# Hubtel (https://hubtel.com — sign up for a Ghana business account)
HUBTEL_CLIENT_ID=xxxxxxxxxxxxxx
HUBTEL_CLIENT_SECRET=xxxxxxxxxxxxxx
HUBTEL_SENDER_ID=BESONC

# Google Cloud (https://console.cloud.google.com — enable Maps Platform)
GOOGLE_MAPS_API_KEY=xxxxxxxxxxxxxx

# Smile ID (https://usesmileid.com — sign up for Ghana)
SMILE_ID_PARTNER_ID=xxxxxxxxxxxxxx
SMILE_ID_API_KEY=xxxxxxxxxxxxxx

# ============================================================================
# DATABASE (free tier services, no card needed)
# ============================================================================

# Neon Postgres (https://neon.tech — free 0.5GB)
DATABASE_URL=postgresql://user:pass@ep-xxxxxx.region.aws.neon.tech/besonc?sslmode=require

# Upstash Redis (https://upstash.com — free 10K commands/day)
REDIS_URL=rediss://default:xxxxxx@xxxxxx.upstash.io:6379

# ============================================================================
# AUTH
# ============================================================================

# JWT secret — change this in production!
JWT_SECRET=besonc-dev-secret-change-in-production-with-64-random-chars-min

# ============================================================================
# OBSERVABILITY (optional, all have free tiers)
# ============================================================================

SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx
GRAFANA_CLOUD_API_KEY=xxxxxx
UPSTASH_REDIS_REST_URL=https://xxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxx

# ============================================================================
# APP CONFIG
# ============================================================================

NODE_ENV=development
PORT_API_GATEWAY=3000
PORT_AUTH_SERVICE=3001
PORT_USER_SERVICE=3002
PORT_CUSTOMER_BFF=4000
