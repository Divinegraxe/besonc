{
  "name": "auth-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/auth-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["dist/apps/auth-service"],
      "options": {
        "command": "npx tsc -p apps/auth-service/tsconfig.json --rootDir ."
      },
      "cache": true
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/auth-service/apps/auth-service/src/main.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
