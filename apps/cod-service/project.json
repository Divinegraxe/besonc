{
  "name": "cod-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cod-service/src",
  "projectType": "application",
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "npx tsc -p apps/cod-service/tsconfig.json --rootDir ." } },
    "serve": { "executor": "nx:run-commands", "options": { "command": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register -P apps/cod-service/tsconfig.json apps/cod-service/src/main.ts", "cwd": "." } }
  }
}
