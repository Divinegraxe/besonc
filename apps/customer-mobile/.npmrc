# React Native + Metro + Expo don't play well with pnpm's default
# symlinked-layout node_modules. They expect a flat hoisted node_modules
# (like npm/yarn). Setting node-linker=hoisted makes pnpm install
# packages into a flat node_modules/ at the project root, the same
# layout these tools assume.
#
# Reference: https://docs.expo.dev/guides/monorepos/#use-hoisting
node-linker=hoisted
