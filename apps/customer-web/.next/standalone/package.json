{
  "name": "besonc",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "BESONC — Multi-Vendor Delivery & Logistics App for Cape Coast, Ghana",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "pnpm run build && node scripts/dev.js",
    "build": "pnpm run build:nest && pnpm run build:web",
    "build:nest": "tsc -p apps/api-gateway/tsconfig.json --rootDir . && tsc -p apps/auth-service/tsconfig.json --rootDir . && tsc -p apps/user-service/tsconfig.json --rootDir . && tsc -p apps/customer-bff/tsconfig.json --rootDir .",
    "build:web": "nx run-many -t build -p customer-web",
    "build:libs": "tsc --noEmit -p tsconfig.base.json",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "dev": "node scripts/dev.js"
  },
  "devDependencies": {
    "@nestjs/common": "10",
    "@nestjs/config": "3",
    "@nestjs/core": "10",
    "@nestjs/jwt": "10",
    "@nestjs/platform-express": "10",
    "@nx/eslint": "19.5.0",
    "@nx/expo": "19.5.0",
    "@nx/jest": "19.5.0",
    "@nx/js": "19.5.0",
    "@nx/nest": "19.5.0",
    "@nx/next": "19.5.0",
    "@nx/node": "19.5.0",
    "@nx/react": "19.5.0",
    "@nx/workspace": "19.5.0",
    "@types/express": "4",
    "@types/node": "20",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@types/supertest": "6",
    "class-transformer": "0.5",
    "class-validator": "0.14",
    "next": "14",
    "nx": "19.5.0",
    "react": "18",
    "react-dom": "18",
    "reflect-metadata": "0.2",
    "rxjs": "7.8",
    "supertest": "7",
    "typescript": "~5.5.0"
  }
}
