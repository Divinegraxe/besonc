{
  "name": "dispatch-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/dispatch-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p apps/dispatch-service/tsconfig.json --rootDir ."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register -P apps/dispatch-service/tsconfig.json apps/dispatch-service/src/main.ts",
        "cwd": "."
      }
    }
  }
}
