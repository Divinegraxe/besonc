{
  "name": "media-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/media-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["dist/apps/media-service"],
      "options": { "command": "npx tsc -p apps/media-service/tsconfig.json --rootDir ." },
      "cache": true
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "node dist/apps/media-service/apps/media-service/src/main.js" }
    }
  }
}
