{
  "name": "tip-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/tip-service/src",
  "projectType": "application",
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "npx tsc -p apps/tip-service/tsconfig.json --rootDir ." } },
    "serve": { "executor": "nx:run-commands", "options": { "command": "./node_modules/.bin/ts-node --transpile-only -r tsconfig-paths/register -P apps/tip-service/tsconfig.json apps/tip-service/src/main.ts", "cwd": "." } }
  }
}
