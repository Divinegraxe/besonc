// BESONC unified Prisma schema.
//
// One schema for the whole monorepo, one generated client at
// /node_modules/@prisma/client. Each NestJS service uses the
// subset of models it owns.
//
// Why one schema instead of one-per-service:
//  - In a monorepo, services often join across tables (e.g. order
//    service reads vendor.id from the catalogue's vendor table).
//  - One client = one consistent type system, easier to evolve.
//  - Migrations apply atomically across all services.
//
// As we add more services (Sprint 5+), append their models here.

generator client {
  provider = "prisma-client-js"
  // No custom output: use the default location so the standard
  // `import { PrismaClient } from '@prisma/client'` works everywhere.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Shared enums ─────────────────────────────────────────────────────

enum ServiceCode {
  FO  // Food
  GR  // Groceries
  SH  // Shop
  MK  // Market
  PH  // Pharmacy & Health
  LD  // Laundry
  PR  // Parcel & Courier
  ER  // Errands
  TR  // Transport (Sprint 5+)
}

enum VendorType {
  business
  individual
}

enum OrderState {
  placed
  vendor_accepted
  preparing
  ready_for_pickup
  rider_assigned
  rider_at_vendor
  picked_up
  in_transit
  arrived
  delivered
  vendor_rejected
  vendor_cancelled
  customer_cancelled
  rider_unassigned
  payment_failed
  prescription_review
  prescription_rejected
  prescription_modified
  rider_assigned_pickup
  rider_at_customer_pickup
  picked_up_from_customer
  delivered_to_vendor
  vendor_received
  processing
  vendor_done
  rider_assigned_return
  rider_at_vendor_return
  picked_up_return
  in_transit_return
  delivered_return
  customer_cancelled_pickup
  rider_cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  momo
  card
  cash
  wallet
}

// ── Catalogue (owned by catalogue-service) ──────────────────────────

model Vendor {
  id                  String     @id  // YDV-YYYY-NNNN
  name                String     @db.VarChar(120)
  description         String?
  logoUrl             String?    @db.VarChar(500)
  bannerUrl           String?    @db.VarChar(500)
  type                VendorType
  city                String     @db.VarChar(8)
  category            ServiceCode
  rating              Decimal    @default(0) @db.Decimal(2, 1)
  reviewCount         Int        @default(0)
  prepTimeMinutes     Int        @default(20)
  minimumOrderPesewas Int        @default(0)
  deliveryFeePesewas  Int        @default(0)
  address             String     @db.VarChar(300)
  latitude            Decimal    @db.Decimal(10, 7)
  longitude           Decimal    @db.Decimal(10, 7)
  phone               String     @db.VarChar(20)
  isVerified          Boolean    @default(false)
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  hours VendorHour[]
  items Item[]

  @@index([city, category, isActive])
  @@index([category, isActive])
  @@index([name])
  @@map("vendor")
}

model VendorHour {
  id        String  @id @default(cuid())
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String  @db.VarChar(5)
  closeTime String  @db.VarChar(5)
  isClosed  Boolean @default(false)

  @@unique([vendorId, dayOfWeek])
  @@index([vendorId])
  @@map("vendor_hour")
}

model Item {
  id                  String   @id  // itm-XXX
  vendorId            String
  vendor              Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name                String   @db.VarChar(200)
  description         String?
  pricePesewas        Int
  imageUrl            String?  @db.VarChar(500)
  available           Boolean  @default(true)
  category            String   @db.VarChar(50)
  preparationMinutes  Int      @default(15)
  tags                String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  addons              Json?
  variants            Json?

  @@index([vendorId, available])
  @@index([vendorId, category])
  @@map("item")
}

// ── Order (owned by order-service) ─────────────────────────────────

model Order {
  id                       String        @id  // YDO-CC-FO-YYYYMMDD-NNNN
  customerId               String        // FK to user-service user (no cross-service FK, just a string)
  riderId                  String?       // assigned at rider_assigned
  service                  ServiceCode
  stateMachine             String        @db.VarChar(1)  // A | B | C | D | E
  state                    OrderState    @default(placed)
  itemTotalPesewas         Int
  deliveryFeePesewas       Int
  serviceFeePesewas        Int
  tipPesewas               Int           @default(0)
  grandTotalPesewas        Int
  paymentMethod            PaymentMethod
  paymentStatus            PaymentStatus @default(pending)
  paymentReference         String?       @db.VarChar(100)
  estimatedPreparationMinutes Int        @default(25)
  estimatedDeliveryAt       DateTime?
  hasDispute               Boolean       @default(false)
  customerNotes            String?
  vendorNotes              String?

  // Lifecycle timestamps
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  placedAt                 DateTime?
  vendorAcceptedAt         DateTime?
  preparingAt              DateTime?
  readyForPickupAt         DateTime?
  riderAssignedAt          DateTime?
  pickedUpAt               DateTime?
  deliveredAt              DateTime?
  cancelledAt              DateTime?

  items                   OrderItem[]
  deliveryAddress         OrderAddress  @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  deliveryAddressId       String        @unique
  pickupAddress           OrderAddress? @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  pickupAddressId         String?       @unique
  stateTransitions        OrderStateTransition[]

  @@index([customerId, createdAt])
  @@index([state, createdAt])
  @@index([riderId, state])
  @@index([paymentStatus])
  @@map("order")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId          String  // FK to catalogue's item.id (no cross-service FK, just a string)
  vendorId        String
  name            String  @db.VarChar(200)
  pricePesewas    Int
  quantity        Int
  variantId       String?
  notes           String?
  addonSelections Json?   // [{addonId, optionId, priceDelta}]

  @@index([orderId])
  @@index([vendorId])
  @@map("order_item")
}

model OrderAddress {
  id                  String  @id @default(cuid())
  label               String  @db.VarChar(50)
  areaName            String  @db.VarChar(100)
  landmark            String? @db.VarChar(200)
  contactPhone        String  @db.VarChar(20)
  recipientName       String? @db.VarChar(100)
  deliveryInstructions String?
  latitude            Decimal @db.Decimal(10, 7)
  longitude           Decimal @db.Decimal(10, 7)

  deliveryForOrder    Order?  @relation("DeliveryAddress")
  pickupForOrder      Order?  @relation("PickupAddress")

  @@map("order_address")
}

model OrderStateTransition {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromState   OrderState
  toState     OrderState
  actor       String?    @db.VarChar(50)  // "customer", "vendor:<id>", "rider:<id>", "system"
  meta        Json?      // riderId, paymentStatus, etc.
  occurredAt  DateTime   @default(now())

  @@index([orderId, occurredAt])
  @@map("order_state_transition")
}

// ── Payments (owned by payment-service) ───────────────────────────

enum PaymentDirection {
  credit  // money coming in (customer paid us)
  debit   // money going out (we paid vendor/rider)
}

enum LedgerReason {
  order_payment
  vendor_settlement
  rider_earning
  rider_payout
  refund
  adjustment
  platform_commission
  delivery_fee
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  customerId          String
  amountPesewas       Int
  method              PaymentMethod
  status              PaymentStatus
  paystackReference   String?       @unique @db.VarChar(100)
  paystackChargeId    String?       @db.VarChar(100)
  mobileMoneyPhone    String?
  mobileMoneyProvider String?       @db.VarChar(16)  // mtn, vod, atl
  failureReason       String?
  createdAt           DateTime      @default(now())
  completedAt         DateTime?

  ledgerEntries       LedgerEntry[]

  @@index([orderId])
  @@index([customerId, createdAt])
  @@index([status])
  @@map("payment")
}

model Payout {
  id                   String        @id @default(cuid())
  recipientId          String        // vendor:YDV-... or rider:YDR-...
  recipientType        String        @db.VarChar(16)
  amountPesewas        Int
  paystackTransferCode String?       @db.VarChar(100)
  status               PaymentStatus @default(pending)
  reason               String        @db.VarChar(50)
  relatedOrderId       String?
  failureReason        String?
  createdAt            DateTime      @default(now())
  completedAt          DateTime?

  ledgerEntries        LedgerEntry[]

  @@index([recipientId, createdAt])
  @@index([status, createdAt])
  @@map("payout")
}

model LedgerEntry {
  id            String           @id @default(cuid())
  userId        String           // 'customer', 'vendor:YDV-...', 'rider:YDR-...', 'PLATFORM_HOLDING'
  userType      String           @db.VarChar(16)
  direction     PaymentDirection
  deltaPesewas  Int              // signed: credit=+, debit=-
  reason        LedgerReason
  referenceType String?          @db.VarChar(16)   // 'order', 'payout', 'payment', etc
  referenceId   String?
  paystackRef   String?          @db.VarChar(100)
  balanceAfter  Int              // running balance after this entry
  description   String?          @db.VarChar(200)
  createdAt     DateTime         @default(now())

  paymentId     String?
  payment       Payment?         @relation(fields: [paymentId], references: [id])

  payoutId      String?
  payout        Payout?          @relation(fields: [payoutId], references: [id])

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("ledger_entry")
}

model UserBalance {
  id             String   @id @default(cuid())
  userId         String   @unique  // 'customer', 'vendor:YDV-...', 'rider:YDR-...', 'PLATFORM_HOLDING'
  userType       String   @db.VarChar(16)
  balancePesewas Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("user_balance")
}

// ── Media (owned by media-service) ───────────────────────────────

enum MediaContext {
  avatar
  vendor_logo
  item_image
  errand_proof
  order_proof
  general
}

model MediaAsset {
  id            String       @id @default(cuid())
  url           String       @db.VarChar(500)
  thumbnailUrl  String?      @db.VarChar(500)
  filename      String       @db.VarChar(200)
  mimeType      String       @db.VarChar(80)
  sizeBytes     Int
  uploadedBy    String       // userId
  context       MediaContext
  storageKey    String?      @db.VarChar(500)  // R2 / S3 key, null in mock mode
  storageBackend String       @default("mock") @db.VarChar(16)  // "mock" | "r2" | "s3"
  createdAt     DateTime     @default(now())

  @@index([uploadedBy, createdAt])
  @@index([context])
  @@map("media_asset")
}
